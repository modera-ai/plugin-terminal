{
  "apiVersion": 1,
  "workspaceTargets": ["local", "ssh"],
  "activationScope": "scoped",
  "id": "pal.terminal",
  "name": "Terminal",
  "version": "0.8.3",
  "description": "执行构建、测试与 Git 命令，支持审批、取消和超时。",
  "author": "Modera",
  "category": "development",
  "icon": "terminal",
  "main": "dist/index.cjs",
  "hostRenderers": {
    "tool-presentation": {
      "root": "dist/ui",
      "entry": "tool-presentation.js"
    }
  },
  "permissions": ["storage.read", "storage.write"],
  "extensions": ["settings"],
  "configScope": "global",
  "config": {
    "agentEnvironment": {
      "type": "enum",
      "title": "Agent environment",
      "default": "windows-native",
      "options": ["windows-native", "wsl"],
      "locales": {
        "zh-CN": {
          "title": "智能体环境"
        }
      }
    },
    "wslDistribution": {
      "type": "string",
      "title": "WSL distribution",
      "default": "",
      "maxLength": 100,
      "locales": {
        "zh-CN": {
          "title": "WSL 发行版"
        }
      }
    },
    "integratedShell": {
      "type": "string",
      "title": "Integrated terminal shell",
      "default": "auto",
      "maxLength": 1000,
      "locales": {
        "zh-CN": {
          "title": "集成终端 Shell"
        }
      }
    },
    "fontFamily": {
      "type": "string",
      "title": "Font family",
      "default": "Cascadia Mono, Consolas, monospace",
      "maxLength": 200
    },
    "fontSize": {
      "type": "number",
      "title": "Font size",
      "default": 13,
      "minimum": 6,
      "maximum": 72
    },
    "lineHeight": {
      "type": "number",
      "title": "Line height",
      "default": 1.2,
      "minimum": 0.5,
      "maximum": 3
    },
    "gpuRendering": {
      "type": "boolean",
      "title": "GPU rendering",
      "default": false
    },
    "scrollback": {
      "type": "number",
      "title": "Scrollback",
      "default": 5000,
      "minimum": 100,
      "maximum": 50000
    }
  },
  "settings": {
    "waitForReady": true,
    "title": "Terminal settings",
    "frontend": "settings",
    "locales": {
      "zh-CN": {
        "title": "终端设置"
      }
    }
  },
  "frontends": {
    "settings": {
      "root": "dist/ui",
      "entry": "settings.html"
    },
    "terminal": {
      "root": "dist/ui",
      "entry": "terminal.html"
    }
  },
  "agentGuidance": "Use the terminal for builds, tests and commands that genuinely require a shell. Use workspace tools for ordinary file edits; use managed background sessions for servers and watchers.",
  "tools": [
    {
      "id": "terminal_execute",
      "description": "Execute one command in the project shell (Windows PowerShell; POSIX bash/sh). Supply a brief description in the user's language. By default this ONE tool call waits until the command finishes, fails, is cancelled or times out; do NOT poll terminal_session for foreground execution. timeout defaults to 1800000ms (30 minutes) for foreground commands. For long-running servers/watchers explicitly set background=true: returns a managed sessionId immediately; use terminal_session to inspect or stop that background job. For USER input set interactive=true: the same call stays pending while the user types in its card. interactive and background cannot be combined. Background timeout is optional. Host approval required. Bounded model output. User OS privileges, NOT sandboxed.",
      "locales": {
        "en": {
          "title": "Execute terminal command"
        },
        "zh-CN": {
          "description": "在项目目录执行命令，默认同一次工具调用等到结束（默认最长30分钟）；background=true才立即返回作业ID。需要用户输入时用interactive=true，不能与background同时使用。不是安全沙箱。"
        }
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string",
            "description": "Briefly explain this command's purpose in the user's language. Shown on its execution card."
          },
          "background": {
            "description": "Return a managed job ID for long commands; not detached from plugin lifecycle.",
            "type": "boolean"
          },
          "command": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "interactive": {
            "description": "One pending command with inline USER input; no model polling. Cannot combine with background.",
            "type": "boolean"
          },
          "timeout": {
            "description": "Process deadline in milliseconds. Foreground/interactive defaults to 1800000 (30 minutes); background has no deadline when omitted.",
            "maximum": 1800000,
            "minimum": 100,
            "type": "integer"
          },
          "workingDirectory": {
            "description": "Project-relative directory; defaults to project root.",
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["command", "description"],
        "type": "object"
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "metrics": [
          {
            "format": "number",
            "label": "退出码",
            "labelEn": "exit code",
            "path": "exitCode"
          },
          {
            "format": "ms",
            "label": "耗时",
            "labelEn": "duration",
            "path": "durationMs"
          }
        ],
        "targets": ["description", "command"],
        "tone": "slate"
      },
      "requiredPermissions": ["process.spawn"],
      "title": "执行终端命令"
    },
    {
      "id": "terminal_session",
      "description": "List, read incremental output or stop managed terminal jobs in this conversation. read uses an absolute character cursor. logs lists persisted log IDs/paths for this conversation; read_log accepts sessionId=log ID and a UTF-8 BYTE cursor, returning nextCursor/hasMore (max 12000 bytes). Reuse returned cursors, do not mix character and byte cursors. Logs survive restart, processes do not. Poll only when needed. No stdin or PTY.",
      "locales": {
        "en": {
          "title": "Manage terminal tasks"
        },
        "zh-CN": {
          "description": "列出、增量读取或停止当前会话的后台命令；logs 列出持久日志，read_log 以 sessionId 指定日志并按 UTF-8 字节 cursor 分页读取。运行输出 read 使用字符 cursor，两者不可混用。"
        }
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": ["list", "read", "stop", "logs", "read_log"]
          },
          "cursor": {
            "minimum": 0,
            "type": "integer"
          },
          "sessionId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": ["action"],
        "type": "object"
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "metrics": [
          {
            "format": "count",
            "label": "个进程",
            "labelEn": "processes",
            "path": "sessions"
          },
          {
            "format": "chars",
            "label": "字符",
            "labelEn": "chars",
            "path": "stdout"
          }
        ],
        "targets": ["action", "sessionId"],
        "tone": "slate"
      },
      "requiredPermissions": ["process.spawn"],
      "title": "管理终端任务"
    },
    {
      "id": "terminal_open",
      "locales": {
        "en": {
          "title": "Open terminal"
        }
      },
      "title": "打开交互终端",
      "description": "Open a persistent interactive PTY in the right panel. Returns tabId. cwd defaults to the project root.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "shellPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "cols": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        }
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["cwd"]
      }
    },
    {
      "id": "terminal_send",
      "locales": {
        "en": {
          "title": "Send terminal input"
        }
      },
      "title": "向终端发送输入",
      "description": "Send text or named keys to a persistent terminal tab. Text receives Enter when it has no trailing newline. keys supports enter, arrows, control keys and F1-F12. Optional description explains complex input on its card; not required for simple answers or key presses.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "string"
          },
          "input": {
            "type": "string",
            "maxLength": 65536
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Optional brief explanation in the user's language, useful for complex commands or multiple commands. Omit for simple answers or key presses."
          }
        },
        "oneOf": [
          {
            "required": ["input"]
          },
          {
            "required": ["keys"]
          }
        ]
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["description"]
      }
    },
    {
      "id": "terminal_read",
      "locales": {
        "en": {
          "title": "Read terminal"
        }
      },
      "title": "读取终端",
      "description": "Read incremental text and raw terminal output from a tab. Reuse nextCursor; waitMs optionally waits for more output first.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "string"
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "waitMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["tabId"]
      }
    },
    {
      "id": "terminal_resize",
      "locales": {
        "en": {
          "title": "Resize terminal"
        }
      },
      "title": "调整终端大小",
      "description": "Resize the PTY dimensions for a terminal tab.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "string"
          },
          "cols": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": ["cols", "rows"]
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["tabId"]
      }
    },
    {
      "id": "terminal_wait",
      "locales": {
        "en": {
          "title": "Wait for terminal idle"
        }
      },
      "title": "等待终端空闲",
      "description": "Wait until a terminal has no new output for idleMs, then return only text not delivered by an earlier wait.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 1800000
          },
          "idleMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 5000
          }
        }
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["tabId"]
      }
    },
    {
      "id": "terminal_close",
      "locales": {
        "en": {
          "title": "Close terminal"
        }
      },
      "title": "关闭终端",
      "description": "Close a terminal tab and terminate its PTY.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "string"
          }
        }
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["tabId"]
      }
    },
    {
      "id": "terminal_focus",
      "locales": {
        "en": {
          "title": "Focus terminal"
        }
      },
      "title": "聚焦终端",
      "description": "Bring a persistent terminal tab to the foreground in the right panel.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["tabId"]
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate",
        "targets": ["tabId"]
      }
    },
    {
      "id": "terminal_list",
      "locales": {
        "en": {
          "title": "List terminals"
        }
      },
      "title": "列出终端",
      "description": "List persistent terminal tabs in this conversation with IDs, directories and active state.",
      "requiredPermissions": ["process.spawn"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "presentation": {
        "icon": "terminal",
        "kind": "terminal",
        "tone": "slate"
      }
    }
  ],
  "locales": {
    "en": {
      "description": "Run build, test and Git commands with approval, cancellation and timeouts."
    },
    "zh-CN": {
      "name": "终端"
    }
  },
  "requiresHost": {
    "plugin.commands.dispatch": 1,
    "plugin.commands.callable": 1,
    "plugin.declarations": 1,
    "frontend.commands.execute": 1,
    "frontend.terminal.lifecycle": 1,
    "plugin.slots": 1,
    "plugin.process.commands": 1,
    "context.commands": 1,
    "context.processPort": 1
  },
  "declarations": {
    "provides": {
      "commands": [
        {
          "id": "pal.terminal.open",
          "title": "Terminal: open",
          "visibility": "public",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cwd": {
                "type": "string"
              },
              "shellPath": {
                "type": "string"
              },
              "cols": {
                "type": "integer",
                "minimum": 2,
                "maximum": 500
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": []
          }
        },
        {
          "id": "pal.terminal.send",
          "title": "Terminal: send",
          "visibility": "public",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              },
              "input": {
                "type": "string",
                "maxLength": 65536
              },
              "keys": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": []
          }
        },
        {
          "id": "pal.terminal.read",
          "title": "Terminal: read",
          "visibility": "public",
          "readOnly": true,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              },
              "cursor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": []
          }
        },
        {
          "id": "pal.terminal.resize",
          "title": "Terminal: resize",
          "visibility": "public",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              },
              "cols": {
                "type": "integer",
                "minimum": 2,
                "maximum": 500
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": ["cols", "rows"]
          }
        },
        {
          "id": "pal.terminal.wait",
          "title": "Terminal: wait",
          "visibility": "public",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              },
              "idleMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 5000
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1800000
              }
            },
            "required": []
          }
        },
        {
          "id": "pal.terminal.close",
          "title": "Terminal: close",
          "visibility": "public",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              }
            },
            "required": []
          }
        },
        {
          "id": "pal.terminal.focus",
          "title": "Terminal: focus",
          "visibility": "public",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              }
            },
            "required": ["tabId"]
          }
        },
        {
          "id": "pal.terminal.list",
          "title": "Terminal: list",
          "visibility": "public",
          "readOnly": true,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          }
        },
        {
          "id": "pal.terminal.input",
          "title": "Terminal: input",
          "visibility": "private",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tabId": {
                "type": "string"
              },
              "data": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "required": ["tabId", "data"]
          }
        },
        {
          "id": "pal.terminal.presentation.read",
          "title": "终端展示read",
          "visibility": "private",
          "readOnly": true,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "id": "pal.terminal.presentation.act",
          "title": "终端展示act",
          "visibility": "private",
          "readOnly": false,
          "requiredPermissions": ["process.spawn"],
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["stop", "input"]
              },
              "value": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": ["action"],
            "additionalProperties": false
          }
        }
      ],
      "ui": [
        {
          "id": "pal.terminal.panel",
          "slot": "ui.panel",
          "description": "固定在打开时会话和工作目录的交互终端。"
        }
      ]
    },
    "consumes": {
      "slots": [
        {
          "id": "pal.terminal.approval",
          "target": {
            "slot": "host.ui.tool.approval",
            "version": 1
          },
          "content": {
            "toolNames": ["terminal_execute"],
            "component": {
              "module": "tool-presentation",
              "export": "default"
            },
            "props": {}
          },
          "commands": ["pal.terminal.presentation.read"]
        },
        {
          "id": "pal.terminal.result",
          "target": {
            "slot": "host.ui.tool.result",
            "version": 1
          },
          "content": {
            "toolNames": [
              "terminal_execute",
              "terminal_session",
              "terminal_open",
              "terminal_send",
              "terminal_read",
              "terminal_resize",
              "terminal_wait",
              "terminal_close",
              "terminal_focus",
              "terminal_list"
            ],
            "component": {
              "module": "tool-presentation",
              "export": "default"
            },
            "props": {}
          },
          "commands": [
            "pal.terminal.presentation.read",
            "pal.terminal.presentation.act"
          ]
        }
      ],
      "commands": [
        {
          "id": "process.start",
          "reason": "使用宿主进程资源与生命周期"
        },
        {
          "id": "process.read",
          "reason": "使用宿主进程资源与生命周期"
        },
        {
          "id": "process.write",
          "reason": "使用宿主进程资源与生命周期"
        },
        {
          "id": "process.resize",
          "reason": "使用宿主进程资源与生命周期"
        },
        {
          "id": "process.stop",
          "reason": "使用宿主进程资源与生命周期"
        },
        {
          "id": "process.list",
          "reason": "使用宿主进程资源与生命周期"
        }
      ]
    }
  }
}
