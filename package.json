{
  "name": "@pal-plugin/terminal",
  "version": "0.8.3",
  "type": "module",
  "description": "Run build, test and Git commands with approval, cancellation and timeouts.",
  "files": [
    "plugin.json",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "pal-plugin-build .",
    "pack": "pal-plugin pack .",
    "release": "pal-plugin release . --publish",
    "dev": "node tools/pal-dev.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs && vitest run"
  },
  "devDependencies": {
    "@pal/contracts": "file:vendor/pal-contracts-0.1.0.tgz",
    "@pal/plugin-build": "file:vendor/pal-plugin-build-0.1.0.tgz",
    "@pal/plugin-sdk": "file:vendor/pal-plugin-sdk-0.1.0.tgz",
    "@pal/ui": "file:vendor/pal-ui-0.1.0.tgz",
    "@types/node": "^24.19.1",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
